// ui/components.templ
package ui

import (
	"fmt"
	"native-rss/db"
	"strconv"
)

// AppShell wraps our sidebar and main content layout
templ AppShell(feeds []db.Feed) {
	<div class="flex h-full w-full overflow-hidden">
		<aside class="w-80 bg-zinc-950 border-r border-zinc-800 flex flex-col justify-between">
			<div class="p-4 flex-1 overflow-y-auto">
				<h1 class="text-xl font-bold tracking-tight text-zinc-50 mb-6">Native RSS</h1>
				
				<form hx-post="/feeds" hx-target="#feed-list" hx-swap="outerHTML" class="mb-6">
					<div class="flex gap-2">
						<input 
							type="url" 
							name="url" 
							placeholder="https://example.com/feed.xml" 
							required
							class="flex-1 min-w-0 px-3 py-1.5 bg-zinc-900 border border-zinc-700 rounded text-sm text-zinc-100 focus:outline-none focus:border-indigo-500"
						/>
						<button 
							type="submit" 
							class="px-3 py-1.5 bg-indigo-600 hover:bg-indigo-500 font-medium text-sm rounded text-white transition"
						>
							Add
						</button>
					</div>
				</form>

				@FeedList(feeds)
			</div>
		</aside>

		<main id="main-content" class="flex-1 bg-zinc-900 overflow-y-auto p-8">
			<div class="max-w-3xl mx-auto text-zinc-400 text-center py-20">
				<p class="text-lg">Select a feed from the sidebar to start reading.</p>
			</div>
		</main>
	</div>
}


// FeedList renders the current feed subscriptions with auto-refresh polling
templ FeedList(feeds []db.Feed) {
	<nav id="feed-list" class="space-y-1" hx-get="/feeds" hx-trigger="every 30s" hx-swap="outerHTML">
		<p class="text-xs font-semibold text-zinc-500 uppercase tracking-wider mb-2">Subscriptions</p>
		
		if len(feeds) == 0 {
			<p class="text-sm text-zinc-500 italic p-2">No feeds added yet.</p>
		}
		
		for _, f := range feeds {
			<div class="flex items-center group relative">
				<button 
					hx-get={ fmt.Sprintf("/feeds/%d/articles", f.ID) }
					hx-target="#main-content"
					class="flex-1 text-left px-3 py-2 text-sm text-zinc-300 hover:bg-zinc-800 rounded transition flex justify-between items-center"
				>
					<span class="truncate pr-6">{ f.URL }</span>
					if f.UnreadCount > 0 {
						<span class="px-2 py-0.5 bg-indigo-600 text-white text-[10px] font-bold rounded-full">
							{ strconv.Itoa(f.UnreadCount) }
						</span>
					}
				</button>

				<button
					hx-delete={ fmt.Sprintf("/feeds/%d", f.ID) }
					hx-target="#feed-list"
					hx-swap="outerHTML"
					hx-confirm="Are you sure you want to unsubscribe from this feed?"
					class="absolute right-2 p-1.5 text-zinc-600 hover:text-red-400 hover:bg-red-400/10 rounded opacity-0 group-hover:opacity-100 transition cursor-pointer"
					title="Delete feed"
				>
					<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
				</button>
			</div>
		}
	</nav>
}
// ArticleList renders the articles for the main reading pane
templ ArticleList(articles []db.Article) {
	<div class="max-w-3xl mx-auto space-y-6">
		if len(articles) == 0 {
			<p class="text-zinc-500 text-center mt-10">No articles found. (If you just added this feed, wait a few seconds and click it again!)</p>
		}
		for _, a := range articles {
			<article class="p-6 bg-zinc-950 rounded-xl border border-zinc-800 hover:border-zinc-700 transition">
				
				<button 
					hx-get={ fmt.Sprintf("/articles/%d", a.ID) }
					hx-target="#main-content"
					class="text-left text-xl font-bold text-zinc-100 hover:text-indigo-400 transition cursor-pointer"
				>
					{ a.Title }
				</button>

				<div class="text-sm text-zinc-400 mt-3 line-clamp-3 leading-relaxed">
					@templ.Raw(a.Description)
				</div>
				
				<div class="mt-4 flex items-center justify-between text-xs font-medium text-zinc-500">
					<span>{ a.PublishedAt.Format("Jan 02, 2006 · 3:04 PM") }</span>
					
					if !a.IsRead {
						<button 
							hx-post={ fmt.Sprintf("/articles/%d/read", a.ID) }
							hx-swap="outerHTML"
							class="px-3 py-1 bg-indigo-500/10 hover:bg-indigo-500 hover:text-white text-indigo-400 rounded-full cursor-pointer transition"
						>
							Mark as read
						</button>
					}
				</div>
			</article>
		}
	</div>
}

// ReadBadge replaces the "Mark as read" button after it is clicked
templ ReadBadge() {
	<span class="px-3 py-1 bg-zinc-800 text-zinc-500 rounded-full cursor-default transition">
		Read
	</span>
}


// FullArticle renders the distraction-free reading view
templ FullArticle(a db.Article) {
	<div class="max-w-3xl mx-auto py-4 animate-in fade-in duration-300">
		<button 
			hx-get={ fmt.Sprintf("/feeds/%d/articles", a.FeedID) } 
			hx-target="#main-content" 
			class="mb-8 flex items-center gap-2 text-sm font-medium text-zinc-500 hover:text-zinc-300 transition"
		>
			<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
			Back to Feed
		</button>

		<h1 class="text-3xl md:text-4xl font-bold text-zinc-50 mb-6 leading-tight">{ a.Title }</h1>
		
		<div class="flex items-center gap-4 text-sm text-zinc-500 mb-10 pb-6 border-b border-zinc-800">
			<span>{ a.PublishedAt.Format("January 2, 2006 · 3:04 PM") }</span>
			<a href={ templ.URL(a.URL) } target="_blank" class="hover:text-indigo-400 flex items-center gap-1">
				View Original 
				<svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
			</a>
		</div>

		<div class="article-body text-lg">
			if a.Content != "" {
				@templ.Raw(a.Content)
			} else {
				@templ.Raw(a.Description)
				<p class="mt-8 text-zinc-500 italic text-sm">Full text extraction was not available for this article.</p>
			}
		</div>
	</div>
}