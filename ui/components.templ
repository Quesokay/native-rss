// ui/components.templ
package ui

import (
	"fmt"
	"native-rss/db"
	"strconv"
	"time"
)

// AppShell wraps our new top-to-bottom newspaper layout
templ AppShell(feeds []db.Feed) {
	<div class="min-h-screen flex flex-col items-center pb-20">
		
		<header class="w-full max-w-5xl pt-8 px-4 md:px-8 flex flex-col">
			<div class="flex justify-between items-end border-b border-stone-400 pb-2 mb-6 text-xs tracking-widest uppercase font-semibold text-stone-600">
				<span>Bulawayo, Zimbabwe</span>
				<span>Vol. I — No. 1</span>
			</div>

			<div class="text-center mb-8">
				<h1 class="text-5xl md:text-8xl font-black tracking-tight text-stone-950 uppercase headline">
					The Native Times
				</h1>
				<p class="mt-4 text-sm italic text-stone-700">A Daily Curated Selection of Feeds & Articles</p>
			</div>

			<div class="border-y-4 border-double border-stone-900 py-3 mb-8 flex flex-col md:flex-row justify-between items-center text-sm font-semibold uppercase tracking-wider gap-4">
				<div class="text-stone-900">
					{ time.Now().Format("Monday, January 2, 2006") }
				</div>
				
				<div class="flex items-center gap-4">
					<form hx-post="/feeds" hx-target="#feed-list" hx-swap="outerHTML" class="flex items-center gap-2">
						<input 
							type="url" 
							name="url" 
							placeholder="Subscribe to URL..." 
							required
							class="bg-transparent border-b border-stone-400 py-1 text-xs focus:outline-none focus:border-stone-900 placeholder-stone-500 w-48 transition-colors"
						/>
						<button type="submit" class="hover:text-stone-500 transition-colors">Subscribe</button>
					</form>
					<span class="text-stone-400">|</span>
					<form hx-post="/feeds/import" hx-target="#feed-list" hx-swap="outerHTML" hx-encoding="multipart/form-data">
						<label class="cursor-pointer hover:text-stone-500 transition-colors flex items-center">
							<input type="file" name="opml_file" accept=".opml,.xml" required class="hidden" onchange="this.form.requestSubmit()" />
							<span>Import OPML</span>
						</label>
					</form>
				</div>
			</div>
		</header>

		<div class="w-full max-w-5xl px-4 md:px-8 mb-12">
			<h3 class="text-xs font-bold uppercase tracking-widest text-stone-500 mb-4 border-b border-stone-300 pb-2">The Index</h3>
			@FeedList(feeds)
		</div>

		<main id="main-content" class="w-full max-w-5xl px-4 md:px-8 flex-1">
			<div class="py-20 text-center italic text-stone-500">
				Select a publication from the Index above to print the front page...
			</div>
		</main>
	</div>
}

// FeedList renders the subscriptions as a dense, multi-column index
templ FeedList(feeds []db.Feed) {
	<div id="feed-list" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-3" hx-get="/feeds" hx-trigger="every 30s" hx-swap="outerHTML">
		if len(feeds) == 0 {
			<p class="text-sm italic text-stone-500 col-span-3">No subscriptions found. The printing press is idle.</p>
		}
		for _, f := range feeds {
			<div class="flex items-center justify-between border-b border-stone-300/50 pb-1 group">
				<button 
					hx-get={ fmt.Sprintf("/feeds/%d/articles", f.ID) }
					hx-target="#main-content"
					hx-swap="innerHTML"  
					class="text-left text-sm text-stone-800 hover:text-stone-950 hover:italic transition-all truncate pr-4"
				>
					{ f.URL }
				</button>
				
				<div class="flex items-center gap-2 flex-shrink-0">
					if f.UnreadCount > 0 {
						<span class="text-[10px] font-bold bg-stone-900 text-[#f4f1ea] px-1.5 py-0.5 rounded-sm">
							{ strconv.Itoa(f.UnreadCount) }
						</span>
					}
					<button
						hx-delete={ fmt.Sprintf("/feeds/%d", f.ID) }
						hx-target="#feed-list"
						hx-swap="outerHTML"
						hx-confirm="Cancel this subscription?"
						class="text-stone-400 hover:text-red-700 opacity-0 group-hover:opacity-100 transition-opacity text-xs font-serif"
						title="Cancel Subscription"
					>
						✕
					</button>
				</div>
			</div>
		}
	</div>
}
// ArticleList renders the articles as a newspaper front page
templ ArticleList(articles []db.Article) {
	<div class="max-w-5xl mx-auto pb-20 animate-in fade-in duration-500">
		if len(articles) == 0 {
			<div class="text-center mt-20 italic text-stone-500 font-serif">
				<p>No articles to print for this issue.</p>
			</div>
		}
		
		<div class="columns-1 md:columns-2 lg:columns-3 gap-8">
			for _, a := range articles {
				<article class="break-inside-avoid mb-8 pb-4 border-b-2 border-stone-300 group">
					
					<div class="mb-2 text-[10px] font-bold uppercase tracking-widest text-stone-500 flex justify-between items-center border-b border-stone-300/50 pb-1">
						<span>{ a.PublishedAt.Format("Jan 02, 2006") }</span>
						if !a.IsRead {
							<button 
								hx-post={ fmt.Sprintf("/articles/%d/read", a.ID) }
								hx-swap="outerHTML"
								class="hover:text-stone-900 transition-colors cursor-pointer"
							>
								[ Mark Read ]
							</button>
						} else {
							@ReadBadge()
						}
					</div>

					<button 
						hx-get={ fmt.Sprintf("/articles/%d", a.ID) }
						hx-target="#main-content"
						hx-swap="innerHTML"  
						class="text-left w-full mt-3"
					>
						<h2 class="text-xl font-black text-stone-900 group-hover:text-stone-600 transition-colors leading-snug headline">
							{ a.Title }
						</h2>
					</button>
				</article>
			}
		</div>
	</div>
}

// ReadBadge replaces the "Mark as read" button
templ ReadBadge() {
	<span class="text-stone-400 italic">Read</span>
}

// FullArticle renders the detailed broadsheet reading view
templ FullArticle(a db.Article) {
	<div class="max-w-3xl mx-auto pb-24 animate-in fade-in duration-500">
		<button 
			hx-get={ fmt.Sprintf("/feeds/%d/articles", a.FeedID) } 
			hx-target="#main-content" 
			class="mb-8 flex items-center gap-2 text-xs font-bold uppercase tracking-widest text-stone-500 hover:text-stone-900 transition-colors cursor-pointer"
		>
			← Back to Front Page
		</button>

		<h1 class="text-4xl md:text-5xl font-black text-stone-950 mb-6 leading-tight headline">{ a.Title }</h1>
		
		<div class="flex items-center justify-between text-xs font-bold uppercase tracking-widest text-stone-600 mb-10 pb-4 border-b-4 border-double border-stone-900">
			<span>Published: { a.PublishedAt.Format("January 2, 2006") }</span>
			<a href={ templ.URL(a.URL) } target="_blank" class="hover:text-stone-900 flex items-center gap-1 transition-colors">
				Read Source ↗
			</a>
		</div>

		if a.EnclosureURL != "" {
			<div class="my-8 p-4 bg-stone-200/50 border border-stone-300">
				<p class="text-[10px] text-stone-600 font-bold mb-2 tracking-widest uppercase">Attached Audio Broadcast</p>
				<audio controls class="w-full h-10 grayscale opacity-80">
					<source src={ a.EnclosureURL } type="audio/mpeg" />
				</audio>
			</div>
		}

		<div class="article-body text-lg first-letter:text-6xl first-letter:font-black first-letter:float-left first-letter:mr-4 first-letter:mt-2 first-letter:text-stone-950">
			if a.Content != "" {
				@templ.Raw(a.Content)
			} else {
				@templ.Raw(a.Description)
				<p class="mt-8 text-stone-500 italic text-sm border-t border-stone-300 pt-4 font-serif">End of excerpt. Full text not provided by the publisher.</p>
			}
		</div>
	</div>
}