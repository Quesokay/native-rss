// ui/components.templ
package ui

import (
	"fmt"
	"native-rss/db"
	"strconv"
)

// AppShell wraps our sidebar and main content layout
templ AppShell(feeds []db.Feed) {
	<div class="flex h-full w-full overflow-hidden">
		<aside class="w-80 bg-zinc-950 border-r border-zinc-800 flex flex-col justify-between">
			<div class="p-4 flex-1 overflow-y-auto">
				<h1 class="text-xl font-bold tracking-tight text-zinc-50 mb-6">Native RSS</h1>
				
				<form hx-post="/feeds" hx-target="#feed-list" hx-swap="outerHTML" class="mb-6">
					<div class="flex gap-2">
						<input 
							type="url" 
							name="url" 
							placeholder="https://example.com/feed.xml" 
							required
							class="flex-1 min-w-0 px-3 py-1.5 bg-zinc-900 border border-zinc-700 rounded text-sm text-zinc-100 focus:outline-none focus:border-indigo-500"
						/>
						<button 
							type="submit" 
							class="px-3 py-1.5 bg-indigo-600 hover:bg-indigo-500 font-medium text-sm rounded text-white transition"
						>
							Add
						</button>
					</div>
				</form>

				@FeedList(feeds)
			</div>
		</aside>

		<main id="main-content" class="flex-1 bg-zinc-900 overflow-y-auto p-8">
			<div class="max-w-3xl mx-auto text-zinc-400 text-center py-20">
				<p class="text-lg">Select a feed from the sidebar to start reading.</p>
			</div>
		</main>
	</div>
}


// FeedList renders the current feed subscriptions with auto-refresh polling
templ FeedList(feeds []db.Feed) {
	<nav id="feed-list" class="space-y-1" hx-get="/feeds" hx-trigger="every 30s" hx-swap="outerHTML">
		<p class="text-xs font-semibold text-zinc-500 uppercase tracking-wider mb-2">Subscriptions</p>
		
		if len(feeds) == 0 {
			<p class="text-sm text-zinc-500 italic p-2">No feeds added yet.</p>
		}
		
		for _, f := range feeds {
			<button 
				hx-get={ fmt.Sprintf("/feeds/%d/articles", f.ID) }
				hx-target="#main-content"
				class="w-full text-left px-3 py-2 text-sm text-zinc-300 hover:bg-zinc-800 rounded transition flex justify-between items-center group"
			>
				<span class="truncate pr-2">{ f.URL }</span>
				
				// Show the unread badge only if there are unread articles!
				if f.UnreadCount > 0 {
					<span class="px-2 py-0.5 bg-indigo-600 group-hover:bg-indigo-500 text-white text-[10px] font-bold rounded-full transition">
						{ strconv.Itoa(f.UnreadCount) }
					</span>
				}
			</button>
		}
	</nav>
}

// ArticleList renders the articles for the main reading pane
templ ArticleList(articles []db.Article) {
	<div class="max-w-3xl mx-auto space-y-6">
		if len(articles) == 0 {
			<p class="text-zinc-500 text-center mt-10">No articles found. (If you just added this feed, wait a few seconds and click it again!)</p>
		}
		for _, a := range articles {
			<article class="p-6 bg-zinc-950 rounded-xl border border-zinc-800 hover:border-zinc-700 transition">
				
				<a href={ templ.URL(a.URL) } target="_blank" class="text-xl font-bold text-zinc-100 hover:text-indigo-400 transition">
					{ a.Title }
				</a>

				<div class="text-sm text-zinc-400 mt-3 line-clamp-3 leading-relaxed">
					@templ.Raw(a.Description)
				</div>
				
				<div class="mt-4 flex items-center justify-between text-xs font-medium text-zinc-500">
					<span>{ a.PublishedAt.Format("Jan 02, 2006 · 3:04 PM") }</span>
					
					if !a.IsRead {
						<button 
							hx-post={ fmt.Sprintf("/articles/%d/read", a.ID) }
							hx-swap="outerHTML"
							class="px-3 py-1 bg-indigo-500/10 hover:bg-indigo-500 hover:text-white text-indigo-400 rounded-full cursor-pointer transition"
						>
							Mark as read
						</button>
					}
				</div>
			</article>
		}
	</div>
}

// ReadBadge replaces the "Mark as read" button after it is clicked
templ ReadBadge() {
	<span class="px-3 py-1 bg-zinc-800 text-zinc-500 rounded-full cursor-default transition">
		Read
	</span>
}